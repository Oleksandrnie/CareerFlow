# Local server (run.py defaults to 127.0.0.1:8000; reload is for development only)
CAREERFLOW_HOST=127.0.0.1
CAREERFLOW_PORT=8000
CAREERFLOW_RELOAD=0

# Optional absolute paths for local data. Keep these outside version control.
# CAREERFLOW_DATA_DIR=/absolute/path/to/careerflow-data
# CAREERFLOW_STORAGE_DIR=/absolute/path/to/careerflow-storage
# CAREERFLOW_DATABASE=/absolute/path/to/careerflow-data/careerflow.db

# General AI / Codex actions. Codex uses the local CLI's existing authentication;
# do not put API keys or access tokens in this file.
CAREERFLOW_CODEX_BINARY=codex
CAREERFLOW_CODEX_MODEL=gpt-5.6-luna
CAREERFLOW_CODEX_EFFORT=low
CAREERFLOW_CODEX_TIMEOUT=180

# Vacancy-description cleanup
CAREERFLOW_CLEANING_CODEX_MODEL=gpt-5.6-luna
CAREERFLOW_CLEANING_CODEX_EFFORT=low
CAREERFLOW_CLEANING_ESCALATION_CODEX_MODEL=gpt-5.6-sol
CAREERFLOW_CLEANING_ESCALATION_CODEX_EFFORT=medium
